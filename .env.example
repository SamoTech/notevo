# Notevo — Environment Variables
# Copy this file to .env.local and fill in your values
# Never commit .env.local to git

# ─────────────────────────────────────────────────
# Supabase — find these in your project:
# Supabase Dashboard → Project Settings → API
# ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─────────────────────────────────────────────────
# Site URL — your production domain (no trailing slash)
# Used for Supabase auth email redirect links.
# On Vercel, also set this as an environment variable in the dashboard.
# ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://notevo-io.vercel.app/

# ─────────────────────────────────────────────────
# Optional: AI features (future)
# ─────────────────────────────────────────────────
GROQ_API_KEY=
